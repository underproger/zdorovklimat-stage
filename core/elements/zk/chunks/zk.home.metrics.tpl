<section class="metrics" aria-label="{'zk.metrics.label' | lexicon}">
    <div class="wrap">
        <div class="metric"><b>{'zk.m1.num' | lexicon}</b><p>{'zk.m1.text' | lexicon}</p></div>
        <div class="metric"><b>{'zk.m2.num' | lexicon}</b><p>{'zk.m2.text' | lexicon}</p></div>
        <div class="metric"><b>{'zk.m3.num' | lexicon}</b><p>{'zk.m3.text' | lexicon}</p></div>
        <div class="metric metric-full">
            <svg class="building-icon" aria-hidden="true"><use href="#i-building"/></svg>
            <p>{'zk.m4.text' | lexicon}</p>
        </div>
    </div>
</section>
