fullname]]<\\/p>\\";s:7:\\"lexicon\\";s:25:\\"sitestatistics:properties\\";s:4:\\"area\\";s:0:\\"\\";}s:8:\\"fullMode\\";a:7:{s:4:\\"name\\";s:8:\\"fullMode\\";s:4:\\"desc\\";s:29:\\"siteonlineusers_prop_fullMode\\";s:4:\\"type\\";s:13:\\"combo-boolean\\";s:7:\\"options\\";a:0:{}s:5:\\"value\\";b:0;s:7:\\"lexicon\\";s:25:\\"sitestatistics:properties\\";s:4:\\"area\\";s:0:\\"\\";}}","moduleguid":"","static":0,"static_file":"core\\/components\\/sitestatistics\\/elements\\/snippets\\/snippet.onlineusers.php","content":"\\/**\\r\\n * @var array $scriptProperties\\r\\n * @var siteStatistics $siteStat\\r\\n *\\/\\r\\nif (!$siteStat = $modx->getService(\'sitestatistics\', \'siteStatistics\', $modx->getOption(\'sitestatistics_core_path\', null, $modx->getOption(\'core_path\') . \'components\\/sitestatistics\\/\') . \'model\\/sitestatistics\\/\')) {\\r\\n\\treturn \'Could not load siteStatistics class!\';\\r\\n}\\r\\nif (empty($tpl)) $scriptProperties[\'tpl\'] = \'tpl.siteOnlineUsers\';\\r\\n\\r\\n$siteStat->initialize($scriptProperties);\\r\\n\\r\\n\\/** @var array $output *\\/\\r\\n$output = $siteStat->getOnlineUsers();\\r\\nif (!empty($toPlaceholder)) {\\r\\n\\t$modx->setPlaceholder($toPlaceholder, $output);\\r\\n}\\r\\nelse {\\r\\n\\treturn $output;\\r\\n}"}',
